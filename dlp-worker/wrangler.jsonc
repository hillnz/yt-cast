{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dlp-worker",
  "main": "src/entry.py",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "DRIVE_ROOT_ID": "",
    "DLP_URL": "",
    "DLP_CONCURRENCY": "8",
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "yt-cast",
    },
  ],
}
