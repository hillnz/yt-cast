{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dlp-worker",
  "main": "src/entry.py",
  "compatibility_date": "2025-11-02",
  "compatibility_flags": ["python_workers", "python_dedicated_snapshot"],
  "vars": {
    "DRIVE_ROOT_ID": "",
    "DLP_URL": "",
    "R2_PUBLIC_URL": "",
    // Operator alert email config. Plumbed via terraform; empty values
    // disable alerting (the worker logs a warning and skips the send).
    "ALERT_EMAIL_FROM": "",
    "ALERT_EMAIL_TO": "",
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "yt-cast",
    },
  ],
  // Cloudflare Email Routing send_email binding. ALERT_EMAIL_TO must be a
  // verified destination address on a Cloudflare-routed domain in this
  // account; ALERT_EMAIL_FROM must be on a domain with Email Routing
  // enabled. Both have to be configured manually in the Cloudflare dash.
  "send_email": [
    {
      "name": "ALERT_MAIL",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "feed-worker-queue",
        "max_batch_size": 1,
        "max_concurrency": 1,
        // Drop messages after 3 failed attempts. No DLQ configured —
        // permanent failures are ack'd in code; only truly transient
        // errors fall back on this retry budget.
        "max_retries": 3,
        "retry_delay": 60,
      },
    ],
  },
}
