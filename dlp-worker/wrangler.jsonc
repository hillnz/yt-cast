{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dlp-worker",
  "main": "src/entry.py",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "DRIVE_ROOT_ID": "",
    "DLP_URL": "",
    "R2_PUBLIC_URL": "",
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "yt-cast",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "feed-worker-queue",
        "max_batch_size": 1,
        "max_concurrency": 1,
      },
    ],
  },
}
