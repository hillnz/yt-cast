{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feed-worker",
  "main": "src/entry.py",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["python_workers"],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "yt-cast",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEED_QUEUE",
        "queue": "feed-worker-queue",
      },
    ],
  },
}
